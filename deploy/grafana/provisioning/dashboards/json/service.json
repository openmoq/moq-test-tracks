    {
      "type": "table",
      "title": "Jobs",
      "description": "Active jobs. obj/s is what the publisher sends: paused when the relay holds the track at Forward State 0. Encoded is the encode rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job_id, content, relay, packaging, video, state) (mtt_job_info)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (job_id, content, relay, packaging, video) (mtt_job_objects_per_second{track=\"video\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (job_id, content, relay, packaging, video) (mtt_job_objects_per_second{track=\"audio\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "1000 * sum by (job_id, content, relay, packaging, video) (mtt_job_kbps)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (job_id, content, relay, packaging, video) (mtt_job_dropped_total)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "sum by (job_id, content, relay, packaging, video) (mtt_job_restarts_total)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "job_id": 0,
              "content": 1,
              "relay": 2,
              "packaging": 3,
              "video": 4,
              "state": 5,
              "Value #B": 6,
              "Value #C": 7,
              "Value #D": 8,
              "Value #E": 9,
              "Value #F": 10
            },
            "renameByName": {
              "job_id": "Job",
              "content": "Content",
              "relay": "Relay",
              "packaging": "Packaging",
              "video": "Video",
              "state": "State",
              "Value #B": "Video obj/s",
              "Value #C": "Audio obj/s",
              "Value #D": "Encoded",
              "Value #E": "Dropped",
              "Value #F": "Restarts"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Video obj/s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "paused",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Audio obj/s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "paused",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Encoded"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Job"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Packaging"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 95
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Video"
            },
            "properties": [
              {
                "id": "custom.width",
