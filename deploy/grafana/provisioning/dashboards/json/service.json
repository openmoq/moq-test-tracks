{
  "uid": "mtt-service",
  "title": "moq-test-tracks",
  "description": "Host load at the top (Platform detail for more), then the jobs: what each is sending, its encode rate, drops and relay-loss restarts.",
  "schemaVersion": 39,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "moq-test-tracks"
  ],
  "links": [
    {
      "title": "Platform detail",
      "type": "link",
      "url": "/grafana/d/mtt-platform",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "asDropdown": false,
      "includeVars": false,
      "tags": []
    }
  ],
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Platform",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "gauge",
      "title": "CPU busy",
      "description": "All cores, last minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Platform detail",
          "url": "/grafana/d/mtt-platform",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": false,
        "showThresholdLabels": false
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "id": 2
    },
    {
      "type": "gauge",
      "title": "Memory used",
      "description": "Excluding reclaimable cache.",
