          "legendFormat": "1 min"
        },
        {
          "refId": "B",
          "expr": "node_load5",
          "legendFormat": "5 min"
        },
        {
          "refId": "C",
          "expr": "node_load15",
          "legendFormat": "15 min"
        },
        {
          "refId": "D",
          "expr": "count(count by (cpu) (node_cpu_seconds_total))",
          "legendFormat": "cores"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
