# Copied to deploy/.env on the host by deploy.sh, which fills in the secrets.
# Never commit deploy/.env.

# Site addresses Caddy serves and gets certificates for, comma separated.
MTT_HOSTNAMES=moq-test.ci.openmoq.org
# Origins the browser dashboard is served from.
MTT_PUBLIC_ORIGINS=https://moq-test.ci.openmoq.org

# Generated by deploy.sh. MTT_TOKEN_SECRET signs every token: keep a copy off
# the host, and changing it invalidates all tokens (docs/admin.md#backup).
# The Grafana admin password is for break-glass use over SSH only; normal
# access goes through the dashboard login.
MTT_RUNNER_TOKEN=
MTT_TOKEN_SECRET=
MTT_SESSION_SECRET=
MTT_GRAFANA_ADMIN_PASSWORD=
