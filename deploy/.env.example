# Copied to deploy/.env on the host by deploy.sh, which fills in the secrets.
# Never commit deploy/.env.

# Site addresses Caddy serves and gets certificates for, comma separated.
MTT_HOSTNAMES=moqx-001.ci.openmoq.org
# Origins the browser dashboard is served from.
MTT_PUBLIC_ORIGINS=https://moqx-001.ci.openmoq.org

# Generated by deploy.sh. The Grafana admin password is for break-glass use
# over SSH only; normal access goes through the dashboard login.
MTT_RUNNER_TOKEN=
MTT_SESSION_SECRET=
MTT_GRAFANA_ADMIN_PASSWORD=
