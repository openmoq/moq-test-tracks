#!/usr/bin/env python3
# Copyright (c) OpenMOQ contributors.
# This source code is licensed under the Apache 2.0 license found in the
# LICENSE file in the root directory of this source tree.

# aiomoqt pub_media adapter (docs/tool-contract.md). Check mode prints the
# plan or the refusal; run mode starts pub_media, passes its @mtt events
# through and logs the rest. Standard library only: it runs in the tool's
# environment.

import json
import os
import signal
import subprocess
import sys
from fractions import Fraction

EXIT_REFUSED = 64
EXIT_UNAVAILABLE = 69
EXIT_INTERNAL = 70
FRACTIONAL_RATES = {
    "23_976": Fraction(24000, 1001),
    "29_97": Fraction(30000, 1001),
    "59_94": Fraction(60000, 1001),
}
TARGET_LATENCY_MS = 250  # draft §Tracks


def plan(req, python=sys.executable):
    """Accept with the pub_media argv and source format, or refuse with reasons."""
    f = req["fields"]
    reasons = []

    def refuse(field, message):
        reasons.append({"field": field, "message": message})

    packaging = f["packaging"]
    has_audio = f["audio_codec"] != "none"
    if f["video_forwarding"] == 1 and packaging == "locmaf":
        refuse("video_forwarding", "LOCMAF has one subgroup per group")
    if f["content"] == "clip" and not req.get("clip"):
        refuse("content", "clip content needs the request's clip")
    if has_audio and f["audio_forwarding"] == 1 and packaging == "locmaf":
        refuse("audio_forwarding", "LOCMAF has one subgroup per group")
    endpoints = req["endpoints"]
    if f["audio_forwarding"] == 3 and packaging != "loc":
        refuse("audio_forwarding", "datagram audio is LOC only")
    if len({e["draft"] for e in endpoints}) != 1:
        refuse("endpoints", "all endpoints must use the same draft")
    if req["tls"].get("ca_file"):
        refuse("tls", "pub_media has no CA file option")
    if reasons:
        return {"accept": False, "reasons": reasons}

    # Clips encode once into a cached loop; only synthetic LOC H.264 encodes live.
    live = packaging == "loc" and f["video_codec"] in ("h264", "h264cb") and f["content"] != "clip"
    source = "mpegts" if live else "mp4"
    path = (req.get("source") or {}).get("path", "<source>")
    duration = f["duration_s"] or req["ttl_s"]
    argv = [python, "-u", "-m", "aiomoqt.tools.pub_media"]
    argv += [e["url"] for e in endpoints]
    argv += ["-N", "/".join(req["namespace"]), "--draft", str(endpoints[0]["draft"])]
    argv += ["-t", str(duration), "--forward", "1", "--stats", "2", "--stats-json"]
    argv += ["--timestamp-mapping", "--reconnect"]
    argv.append("--pub-ns" if req["mode"] == "namespace" else "--pub-both")
    if not req["tls"].get("verify", True):
        argv.append("-k")
    if live:
        argv += ["--ts", path, "--ts-cadence", _cadence(f)]
        argv += ["--catalog-bitrate", str(f["video_kbps"] * 1000)]
    else:
        argv += ["--mp4", path, "--loop", "--packaging", packaging]
    if f["catalog"] == "none":
        argv.append("--no-catalog")
    else:
        argv += ["--target-latency", str(TARGET_LATENCY_MS)]
        if packaging == "loc":
            argv += ["--init-data", f["init_data"]]
    if f["video_forwarding"] == 1:
        argv += ["--video-subgroups", "object"]
    if not has_audio:
        argv.append("--no-audio")
    else:
        argv += ["--audio-frames-per-group", str(f["audio_frames_per_group"])]
        if f["audio_forwarding"] == 1:
            argv += ["--audio-subgroups", "object"]
        elif f["audio_forwarding"] == 3:
            argv.append("-D")
    notes = []
    if f["catalog"] == "none":
        notes.append(
            "decoder config rides VIDEO_CONFIG / AUDIO_CONFIG on each group's first object,"
            " not in the media itself"
        )
    return {"accept": True, "source": source, "argv": argv, "notes": notes}


def _cadence(f):
    """--ts-cadence for the namespace's frame rate and group duration."""
    fps = FRACTIONAL_RATES.get(f["frame_rate"]) or Fraction(f["frame_rate"])
    gop = int(Fraction(f["group_ms"], 1000) * fps)
    rate = str(fps.numerator) if fps.denominator == 1 else f"{fps.numerator}/{fps.denominator}"
    return f"fps={rate},gop={gop}"


def run(req):
    p = plan(req)
    if not p["accept"]:
        print(json.dumps(p), file=sys.stderr)
        return EXIT_REFUSED
    # pub_media writes @mtt events on stdout and its log on stderr.
    child = subprocess.Popen(  # noqa: S603 - argv list from plan(), no shell
        p["argv"], stdout=subprocess.PIPE, text=True, bufsize=1
    )
    # The stop signal reaches the whole process group; pub_media handles
    # SIGINT itself, so the adapter only waits. SIGTERM is turned into SIGINT.
    signal.signal(signal.SIGINT, lambda *_: None)
    signal.signal(signal.SIGTERM, lambda *_: child.send_signal(signal.SIGINT))
    done = False
    for line in child.stdout:
        event = _event(line)
        if event is None:
            sys.stderr.write(line)
            continue
        done = done or event.get("event") == "done"
        sys.stdout.write(line)
        sys.stdout.flush()
    rc = child.wait()
    if not done:
        print("@mtt " + json.dumps({"event": "done", "reason": f"exit {rc}"}), flush=True)
    if rc == 0 or rc == -signal.SIGINT:
        return 0
    return rc if rc in (EXIT_REFUSED, EXIT_UNAVAILABLE, EXIT_INTERNAL) else EXIT_INTERNAL


def _event(line):
    """The JSON of an @mtt line, or None for log output."""
    if not line.startswith("@mtt "):
        return None
    try:
        event = json.loads(line[5:])
    except ValueError:
        return None
    return event if isinstance(event, dict) else None


def main():
    with open(os.environ["MTT_REQUEST_FILE"]) as fh:
        req = json.load(fh)
    mode = os.environ.get("MTT_MODE")
    if mode == "check":
        p = plan(req)
        print(json.dumps(p))
        return 0 if p["accept"] else EXIT_REFUSED
    if mode == "run":
        return run(req)
    print("MTT_MODE must be check or run", file=sys.stderr)
    return EXIT_INTERNAL


if __name__ == "__main__":
    sys.exit(main())
